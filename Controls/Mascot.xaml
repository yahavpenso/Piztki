<UserControl x:Class="Piztki.Controls.Mascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Viewbox Stretch="Uniform">
        <Canvas Width="120" Height="96">
            <Canvas>
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="BobT"/>
                </Canvas.RenderTransform>

                <!-- floating hands -->
                <Grid x:Name="HandL" Canvas.Left="12" Canvas.Top="50" Width="19" Height="19">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="HandLT"/>
                    </Grid.RenderTransform>
                    <Ellipse x:Name="HandLShape" Fill="#1B1830" StrokeThickness="1.7"/>
                    <Ellipse Width="1.6" Height="1.6" Fill="White" Opacity="0.7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,5,0,0"/>
                    <Ellipse Width="1.1" Height="1.1" Fill="#CECBF6" Opacity="0.7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="11,11,0,0"/>
                </Grid>
                <Grid x:Name="HandR" Canvas.Left="89" Canvas.Top="50" Width="19" Height="19">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="HandRT"/>
                    </Grid.RenderTransform>
                    <Ellipse x:Name="HandRShape" Fill="#1B1830" StrokeThickness="1.7"/>
                    <Ellipse Width="1.6" Height="1.6" Fill="White" Opacity="0.7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,5,0,0"/>
                    <Ellipse Width="1.1" Height="1.1" Fill="#F4C0D1" Opacity="0.7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,12,0,0"/>
                </Grid>

                <!-- cube body -->
                <Grid Canvas.Left="32" Canvas.Top="18" Width="56" Height="56" RenderTransformOrigin="0.5,0.9">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="BodyR"/>
                    </Grid.RenderTransform>

                    <Border x:Name="BodyShape" CornerRadius="16" BorderThickness="1.7">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#262146" Offset="0"/>
                                <GradientStop Color="#16132A" Offset="0.6"/>
                                <GradientStop Color="#0F0D1E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- texture (stars, carbon, waves...), filled in code -->
                    <Canvas x:Name="Stars"/>

                    <!-- soft top highlight -->
                    <Border CornerRadius="4" Height="6" Width="24" Background="White" Opacity="0.10"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,6,0,0"/>

                    <!-- face -->
                    <Canvas>
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="FaceT"/>
                        </Canvas.RenderTransform>
                        <Rectangle Canvas.Left="12" Canvas.Top="23" Width="11" Height="6.5" RadiusX="3.25" RadiusY="3.25"
                                   Fill="White" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="EyeLS"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Canvas.Left="33" Canvas.Top="23" Width="11" Height="6.5" RadiusX="3.25" RadiusY="3.25"
                                   Fill="White" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="EyeRS"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Path x:Name="Mouth" Data="M 23,37 Q 28,41.5 33,37" Stroke="White" StrokeThickness="2.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>

                    <!-- hat, drawn above the cube so it tilts with it -->
                    <Canvas x:Name="HatLayer"/>
                </Grid>

                <!-- a sleepy "z" -->
                <TextBlock x:Name="Zzz" Text="z" Canvas.Left="90" Canvas.Top="8" FontSize="15" FontWeight="Bold"
                           Foreground="White" Opacity="0" FontFamily="Segoe UI"/>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
