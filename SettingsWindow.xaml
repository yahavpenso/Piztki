                                         LostFocus="Countdown_Changed" KeyDown="Countdown_KeyDown"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,210,0">
                                    <TextBlock Text="The date" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="CountdownHint" Text="Year-month-day, like 2027-01-31. Leave empty for no countdown" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <TextBox x:Name="CountdownDateBox" Style="{StaticResource DarkTextBox}" Width="190" HorizontalAlignment="Right" MaxLength="10"
                                         LostFocus="Countdown_Changed" KeyDown="Countdown_KeyDown"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- shelf and clipboard -->
                <StackPanel x:Name="PageShelf" Visibility="Collapsed">
                    <TextBlock Text="Shelf" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <Grid Style="{StaticResource Row}">
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Text="Start with an empty shelf" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Files left on the shelf are cleared each time Piztki starts. The files themselves are never touched" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShelfClearOnStart}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Clipboard list" Style="{StaticResource Group}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Keep up to" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Slider Style="{StaticResource DarkSlider}" Width="190" Minimum="3" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ClipMax}"/>
                                    <TextBlock Text="{Binding ClipMax, StringFormat={}{0} items}" Style="{StaticResource Value}"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Remember after restart" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Off forgets the list when Piztki closes. On saves it on this PC only, so think twice if you copy passwords" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ClipRemember}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- discord -->
                <StackPanel x:Name="PageDiscord" Visibility="Collapsed">
                    <TextBlock Text="Discord" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Messages from Discord already show in the notch (General, Notifications from other apps). This page adds two more things: a status on your profile, and voice controls." Style="{StaticResource Group}" TextWrapping="Wrap" Margin="4,-8,0,12"/>
                    <!-- the step-by-step guide: a drawing of where to press, the words, and a check once it worked -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="16,12,16,14">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel x:Name="GuideDots" Orientation="Horizontal" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GuideCount" Text="Step 1 of 5" Style="{StaticResource RowHint}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="GuideArt" Height="132" CornerRadius="10" Background="#FF1E1F26" Margin="0,12,0,0" ClipToBounds="True"/>
                            <StackPanel x:Name="GuideText" Margin="0,12,0,0">
                                <TextBlock x:Name="GuideTitle" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="GuideBody" FontSize="12.5" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="GuideCheck" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock x:Name="GuideCheckIcon" Tag="" Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GuideCheckText" FontSize="12" Margin="7,0,7,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
                            </StackPanel>
                            <Grid Margin="0,14,0,0">
                                <Button x:Name="GuideAction" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Click="GuideAction_Click"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="GuideBack" Style="{StaticResource GhostButton}" Content="Back" Click="GuideBack_Click"/>
                                    <Button x:Name="GuideNext" Style="{StaticResource PillButton}" Content="Next" Margin="8,0,0,0" Click="GuideNext_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Application ID" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource DarkTextBox}" Width="250" Height="32" FontSize="12.5" MaxLength="24" HorizontalAlignment="Right"
                                         Text="{Binding DiscordAppId, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,262,0">
                                    <TextBlock Text="Client Secret" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Stays on this PC. Never share it" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource DarkTextBox}" Width="250" Height="32" FontSize="12.5" MaxLength="64" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Text="{Binding DiscordSecret, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <TextBlock x:Name="DiscordStatusText" Style="{StaticResource RowHint}" Margin="16,10,16,12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Status on my profile" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Friends see your running focus timer, or the song that's playing" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DiscordPresence}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Voice controls" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Mute, deafen, and who is talking, in the Sound tab. Works on your own Discord account" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DiscordVoice}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,190,0">
                                    <TextBlock Text="Connect voice controls" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Discord opens a window. Press Authorize there" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <Button x:Name="DiscordVoiceBtn" Style="{StaticResource PillButton}" Content="Connect" HorizontalAlignment="Right" VerticalAlignment="Center" Click="DiscordVoice_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- about -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Margin="0,44,0,22">
                        <c:Mascot Width="140" Height="112" Accent="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Piztki" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock x:Name="VersionText" Text="Version 1.0.0" FontSize="12" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock Text="A friendly little notch for Windows" FontSize="12.5" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource GhostButton}" Content="Quit Piztki" HorizontalAlignment="Center" Click="Quit_Click"/>

                    <!-- the free services and libraries Piztki stands on -->
                    <TextBlock Text="Thanks to" Style="{StaticResource Group}" Margin="4,26,0,6"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="16,12">
                            <TextBlock Style="{StaticResource RowHint}" Margin="0">
                                <Run Text="Lyrics" Foreground="{StaticResource TextBrush}"/><Run Text="  from LRCLIB (lrclib.net), a free and open lyrics database."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource RowHint}" Margin="0,6,0,0">
                                <Run Text="Weather" Foreground="{StaticResource TextBrush}"/><Run Text="  data by Open-Meteo.com, under the CC BY 4.0 license."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource RowHint}" Margin="0,6,0,0">
                                <Run Text="Exchange rates" Foreground="{StaticResource TextBrush}"/><Run Text="  from Frankfurter (frankfurter.dev), using European Central Bank reference rates. Server locations from ipwho.is."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource RowHint}" Margin="0,6,0,0">
                                <Run Text="Find my location" Foreground="{StaticResource TextBrush}"/><Run Text="  uses GeoJS (geojs.io)."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource RowHint}" Margin="0,6,0,0">
                                <Run Text="Sound analysis" Foreground="{StaticResource TextBrush}"/><Run Text="  uses NAudio by Mark Heath and contributors, under the MIT license."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource RowHint}" Margin="0,10,0,0"
                                       Text="Piztki has no account and no tracking. Your tasks, events, and settings stay on this PC. The services above only receive what each feature needs (a song's title and artist, a city name), and only while that feature is switched on."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
