<Window x:Class="Piztki.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Piztki.Controls"
        xmlns:core="clr-namespace:Piztki.Core"
        Title="Piztki settings" Width="720" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="16,12"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
            <Setter Property="Margin" Value="4,0,0,6"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Margin" Value="16,0"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="74"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="core:Fx.Press" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,1" Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="9" Background="#10FFFFFF" Opacity="0"/>
                            <Border x:Name="Selected" CornerRadius="9" Background="#20FFFFFF" Opacity="0"/>
                            <ContentPresenter Margin="12,9"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="core:Fx.Press" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="26" Height="26" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Margin="4" Fill="{TemplateBinding Background}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource Spring}"/>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource Spring}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.6" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.6" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a slim, dark scroll bar in place of the wide gray Windows one -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bar" CornerRadius="3" Background="#38FFFFFF" Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bar" Property="Background" Value="#66FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bar" Property="Background" Value="#88FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a city suggestion -->
        <Style x:Key="PlaceRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="core:Fx.Press" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="9" Background="#1CFFFFFF" Opacity="0"/>
                            <ContentPresenter Margin="11,7"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- one option of a segmented picker -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="74"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
            <Setter Property="core:Fx.Press" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Selected" CornerRadius="8" Background="{DynamicResource AccentBrush}" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="16" CornerRadius="16" Background="#FF17171C" BorderBrush="#22FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Drag_MouseLeftButtonDown" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.94" ScaleY="0.94"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- sidebar -->
            <Border Background="#0CFFFFFF" CornerRadius="16,0,0,16">
                <DockPanel Margin="12,16,12,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,16">
                        <c:Mascot Width="44" Height="36" Accent="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Piztki" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" SelectedIndex="0"
                             ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBoxItem Content="General"/>
                        <ListBoxItem Content="Notch"/>
                        <ListBoxItem Content="Features"/>
                        <ListBoxItem Content="Music"/>
                        <ListBoxItem Content="Mascot"/>
                        <ListBoxItem Content="Style"/>
                        <ListBoxItem Content="Timers"/>
                        <ListBoxItem Content="Water"/>
                        <ListBoxItem Content="Weather"/>
                        <ListBoxItem Content="Calendar"/>
                        <ListBoxItem Content="Shelf"/>
                        <ListBoxItem Content="Discord"/>
                        <ListBoxItem Content="About"/>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- pages -->
            <Grid Grid.Column="1" Margin="26,22,6,10">
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-6,10,0" Click="Close_Click" ToolTip="Close" Panel.ZIndex="2"/>

                <!-- pages taller than the window scroll (mouse wheel, or drag the slim bar on the right) -->
                <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <Grid Margin="0,0,20,10">

                <!-- general -->
                <StackPanel x:Name="PageGeneral">
                    <TextBlock Text="General" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Startup" Style="{StaticResource Group}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource Row}">
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Text="Show in the Start menu" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Adds Piztki to the list of apps, so you can search for it and pin it" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartMenuShortcut}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Behavior" Style="{StaticResource Group}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Hide in full screen" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Slides away for games, videos, and slides that fill the screen" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HideInFullscreen}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Game mode" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="While a game fills the screen, a tiny strip at the top middle shows the time and how busy the PC is" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GameMode}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Game summary" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Fortnite: place, eliminations, and damage (replays must be on). Roblox: the game, server, players, and ping. Any other game: which one and how long you played" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MatchSummary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Counter-Strike 2 matches" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="After a match: the score, the map, and your kills and deaths. Adds a small settings file to the game, the way Valve provides for this. Restart the game after switching on" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Cs2Summary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Reminder sounds" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="A chime for the focus timer and water reminders" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Sounds}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="24-hour clock" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Off shows the time as 3:45 PM" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Use24Hour}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Popups" Style="{StaticResource Group}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Volume popup" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="The notch shows the level whenever the volume changes" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding VolumeHud}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Battery alerts" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Plugging in, unplugging, and a warning at 20%. Laptops only" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BatteryAlerts}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Caps Lock" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="A quick note when Caps Lock turns on or off" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HudCapsLock}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Keyboard language" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Shows the language you just switched to" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HudLanguage}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Internet connection" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Tells you when the connection drops and when it's back" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HudNetwork}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Microphone and camera" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="A dot in the notch while an app uses the microphone (orange) or the camera (green)" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PrivacyDots}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Notifications from other apps" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="A new message or alert from any app shows in the notch for a few seconds" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowNotifications}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Stretch reminders" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="A nudge to stand up after this long at the screen without a break" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StretchReminders}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Remind me every" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" Background="#16FFFFFF" CornerRadius="10" Padding="2">
                                    <StackPanel x:Name="StretchOptions" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Width="54" Content="30 min" Tag="30" Click="Stretch_Click"/>
                                        <RadioButton Style="{StaticResource Segment}" Width="54" Content="45 min" Tag="45" Click="Stretch_Click"/>
                                        <RadioButton Style="{StaticResource Segment}" Width="54" Content="1 h" Tag="60" Click="Stretch_Click"/>
                                        <RadioButton Style="{StaticResource Segment}" Width="54" Content="1.5 h" Tag="90" Click="Stretch_Click"/>
                                        <RadioButton Style="{StaticResource Segment}" Width="54" Content="2 h" Tag="120" Click="Stretch_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- notch -->
                <StackPanel x:Name="PageNotch" Visibility="Collapsed">
                    <TextBlock Text="Notch" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Screen" Style="{StaticResource Group}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="16,12">
                            <TextBlock Text="Which screen the notch lives on" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="ScreenHint" Text="Click a screen to move the notch there" Style="{StaticResource RowHint}"/>
                            <!-- one button per connected monitor, filled in from code -->
                            <WrapPanel x:Name="Screens" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Look and feel" Style="{StaticResource Group}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,170,0">
                                    <TextBlock Text="Style" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Floating sits just below the top edge. Attached joins it" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#16FFFFFF" CornerRadius="10" Padding="2">
                                    <StackPanel x:Name="Styles" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="Floating" Tag="Floating" Click="NotchStyle_Click"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="Attached" Tag="Attached" Click="NotchStyle_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Minimal notch" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="A small pill with no clock while nothing is playing" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MinimalNotch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Faster animations" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Everything opens and moves about twice as quickly" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FastAnimations}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Size" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" Background="#16FFFFFF" CornerRadius="10" Padding="2">
                                    <StackPanel x:Name="Sizes" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="Small" Tag="Small" Click="Size_Click"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="Medium" Tag="Medium" Click="Size_Click"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="Large" Tag="Large" Click="Size_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Open with a click" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Off opens the notch as soon as the pointer touches it" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ClickToOpen}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- features -->
                <StackPanel x:Name="PageFeatures" Visibility="Collapsed">
                    <TextBlock Text="Features" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Switch off anything you don't use and its tab disappears from the notch." Style="{StaticResource Group}" TextWrapping="Wrap" Margin="4,-8,0,12"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Music" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Song, artist, and controls from any app that plays music" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowMusic}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Timers" Style="{StaticResource RowTitle}"/>
