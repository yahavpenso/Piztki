<Window x:Class="Piztki.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Piztki.Controls"
        xmlns:core="clr-namespace:Piztki.Core"
        Title="Piztki menu" Width="236" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="core:Fx.Press" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="9" Background="#1CFFFFFF" Opacity="0"/>
                            <ContentPresenter VerticalAlignment="Center" Margin="10,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="8" CornerRadius="14" Background="#FF17171C" BorderBrush="#2CFFFFFF" BorderThickness="1"
            Opacity="0" RenderTransformOrigin="1,1">
        <StackPanel Margin="6">

            <!-- who's talking -->
            <Grid Margin="6,6,6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <c:Mascot x:Name="Face" Width="50" Height="40" Accent="{DynamicResource AccentBrush}"
                          Texture="{Binding Texture}" Hat="{Binding Hat}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="Piztki" FontSize="14.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Text="Level 1" FontSize="11.5" Foreground="{StaticResource SubtleBrush}"/>
                </StackPanel>
            </Grid>

            <Border Height="1" Background="#16FFFFFF" Margin="6,0,6,4"/>

            <Button x:Name="RowSettings" Style="{StaticResource MenuRow}" Click="Settings_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" Style="{StaticResource RowIcon}"/>
                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="RowHide" Style="{StaticResource MenuRow}" Click="Hide_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="HideIcon" Text="&#xE70E;" Style="{StaticResource RowIcon}"/>
                    <TextBlock x:Name="HideLabel" Text="Hide the notch" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Border Height="1" Background="#16FFFFFF" Margin="6,4"/>

            <Button x:Name="RowQuit" Style="{StaticResource MenuRow}" Click="Quit_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7E8;" Style="{StaticResource RowIcon}" Foreground="#F09595"/>
                    <TextBlock Text="Quit Piztki" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
