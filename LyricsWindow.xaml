<Window x:Class="Piztki.LyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Piztki.Controls"
        Title="Piztki cinema"
        WindowStyle="None" ResizeMode="NoResize" Background="#FF07070A"
        FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" KeyDown="Window_KeyDown">

    <Grid x:Name="Root" Opacity="0">

        <!-- large soft clouds in the cover's colors, wandering slowly across the whole screen -->
        <Canvas x:Name="Sky" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="Sky1"><Ellipse.RenderTransform><TranslateTransform x:Name="Sky1T"/></Ellipse.RenderTransform></Ellipse>
            <Ellipse x:Name="Sky2"><Ellipse.RenderTransform><TranslateTransform x:Name="Sky2T"/></Ellipse.RenderTransform></Ellipse>
            <Ellipse x:Name="Sky3"><Ellipse.RenderTransform><TranslateTransform x:Name="Sky3T"/></Ellipse.RenderTransform></Ellipse>
            <Ellipse x:Name="Sky4"><Ellipse.RenderTransform><TranslateTransform x:Name="Sky4T"/></Ellipse.RenderTransform></Ellipse>
        </Canvas>

        <Grid x:Name="Stage" Margin="90,70,90,70">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <!-- the song -->
            <StackPanel x:Name="SongSide" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,60,0">
                <Border x:Name="Cover" Width="360" Height="360" CornerRadius="28" Background="#1AFFFFFF">
                    <Grid>
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="70" Foreground="{StaticResource SubtleBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="CoverImage" CornerRadius="28">
                            <Border.Background>
                                <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock x:Name="TitleText" FontSize="34" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                           MaxHeight="96" TextTrimming="CharacterEllipsis" Margin="0,26,0,0"/>
                <TextBlock x:Name="ArtistText" FontSize="20" Foreground="#C8FFFFFF" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>

                <!-- progress: click to jump -->
                <Grid Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="54"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PosText" Text="0:00" FontSize="14" Foreground="#B4FFFFFF" VerticalAlignment="Center"/>
                    <Grid x:Name="SeekTrack" Grid.Column="1" Height="22" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Seek_Click">
                        <Border Height="5" CornerRadius="2.5" Background="#38FFFFFF" VerticalAlignment="Center">
                            <Border CornerRadius="2.5" Background="White" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SeekBarS" ScaleX="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" FontSize="14" Foreground="#B4FFFFFF" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" Width="52" Height="52" FontSize="20" Click="Prev_Click" ToolTip="Previous"/>
                    <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Content="&#xE768;" Width="64" Height="64" FontSize="28" Margin="14,0" Click="Play_Click" ToolTip="Play or pause"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" Width="52" Height="52" FontSize="20" Click="Next_Click" ToolTip="Next"/>
                </StackPanel>
            </StackPanel>

            <!-- the words -->
            <Grid Grid.Column="1">
                <c:LyricsColumn x:Name="Col" LineFontSize="40" LineGap="13" FocusAt="0.42"/>
                <StackPanel x:Name="NoLyrics" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="NoLyricsText" Text="Lyrics not available" FontSize="30" FontWeight="SemiBold" Foreground="#B4FFFFFF"/>
                    <TextBlock Text="Sit back and enjoy the music." FontSize="18" Foreground="#80FFFFFF" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,26,0">
            <TextBlock Text="Esc to close" FontSize="13" Foreground="#70FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="40" Height="40" FontSize="15" Click="Close_Click" ToolTip="Close the cinema"/>
        </StackPanel>
    </Grid>
</Window>
