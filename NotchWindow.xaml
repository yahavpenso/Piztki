<Window x:Class="Piztki.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Piztki.Controls"
        xmlns:core="clr-namespace:Piztki.Core"
        Title="Piztki" Width="820" Height="330"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- small text segment used for the timer modes -->
        <Style x:Key="MiniSegment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
            <Setter Property="core:Fx.Press" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Selected" CornerRadius="7" Background="#26FFFFFF" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="9,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a full-width row that highlights on hover (clipboard entries) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="8" Background="#1CFFFFFF" Opacity="0"/>
                            <ContentPresenter Margin="8,5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a feature card on the home tab -->
        <Style x:Key="HomeCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="core:Fx.Press" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="12" Background="#16FFFFFF"/>
                            <Border x:Name="Hover" CornerRadius="12" Background="#16FFFFFF" Opacity="0"/>
                            <ContentPresenter Margin="9,7,8,7"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- the multi-line box on the Notes tab -->
        <Style x:Key="NoteBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border CornerRadius="10" Background="#1AFFFFFF"/>
                            <Border x:Name="Hover" CornerRadius="10" Background="#12FFFFFF" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Opacity="0"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="9,6"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="StatTrack" TargetType="Border">
            <Setter Property="Height" Value="5"/>
            <Setter Property="CornerRadius" Value="2.5"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The shell holds the notch plus the two small curved "shoulders" that blend it into the
             top edge of the screen in the attached style. Scaling, sliding, and hiding act on the shell. -->
        <StackPanel x:Name="Shell" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
            <StackPanel.LayoutTransform>
                <ScaleTransform x:Name="IslandScale"/>
            </StackPanel.LayoutTransform>
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="IslandT" Y="-70"/>
            </StackPanel.RenderTransform>

            <Path x:Name="ShoulderLeft" Data="M 0,0 L 12,0 L 12,12 A 12,12 0 0 0 0,0 Z" Fill="#FF0A0A0D"
                  VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"/>

        <Border x:Name="Island" VerticalAlignment="Top"
                Width="150" Height="38" CornerRadius="24"
                Background="#FF0A0A0D" BorderBrush="#26FFFFFF" BorderThickness="1"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                MouseLeftButtonDown="Island_MouseLeftButtonDown"
                MouseMove="Island_MouseMove" MouseLeftButtonUp="Island_MouseLeftButtonUp"
                AllowDrop="True" DragEnter="Island_DragEnter" DragOver="Island_DragOver" DragLeave="Island_DragLeave" Drop="Island_Drop">

            <Grid ClipToBounds="True">

                <!-- a glow in the playing song's cover color, rising from the bottom edge -->
                <Border x:Name="Tint" CornerRadius="23" Opacity="0" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop x:Name="TintTop" Color="#00000000" Offset="0.1"/>
                            <GradientStop x:Name="TintBottom" Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- collapsed pill -->
                <Grid x:Name="Mini" Margin="5,0,14,0" Height="36" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- lit while some app is using the microphone (orange) or the camera (green) -->
                    <StackPanel x:Name="PrivacyRow" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="NetDot" Width="5" Height="5" Fill="#FFFF6B6B" Margin="4,0,0,0" Visibility="Collapsed" ToolTip="No internet connection"/>
                        <Ellipse x:Name="MicDot" Width="5" Height="5" Fill="#FFFFA53D" Margin="4,0,0,0" Visibility="Collapsed" ToolTip="An app is using the microphone"/>
                        <Ellipse x:Name="CamDot" Width="5" Height="5" Fill="#FF4ADE80" Margin="3,0,0,0" Visibility="Collapsed" ToolTip="An app is using the camera"/>
                    </StackPanel>
                    <c:Mascot x:Name="MiniMascot" Width="40" Height="32" Margin="0,1,4,0" Small="True"
                              Accent="{DynamicResource AccentBrush}" Texture="{Binding Texture}" Hat="{Binding Hat}"/>
                    <TextBlock x:Name="MiniText" Grid.Column="1" Text="12:00" FontSize="12.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                    <!-- volume popup -->
                    <Grid x:Name="MiniHud" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HudIcon" Text="&#xE767;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Height="5" CornerRadius="2.5" Background="#30FFFFFF" Margin="10,0,6,0" VerticalAlignment="Center">
                            <Border CornerRadius="2.5" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="HudBarS" ScaleX="0.5"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock x:Name="HudText" Grid.Column="2" Text="50%" FontSize="12" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel x:Name="MiniBars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="8,0,0,0" Height="14" Visibility="Collapsed">
                        <Rectangle x:Name="Bar1" Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar2" Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.8"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar3" Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.55"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                </Grid>

                <!-- expanded panel -->
                <Grid x:Name="Full" Width="488" Height="220" Margin="16,14,16,14" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="108"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- mascot, level, clock, weather -->
                    <StackPanel x:Name="LeftCol" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Grid x:Name="MascotHost" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Mascot_MouseLeftButtonDown"
                              ToolTip="Poke Piztki">
                            <c:Mascot x:Name="BigMascot" Width="92" Height="76" Accent="{DynamicResource AccentBrush}"
                                      Texture="{Binding Texture}" Hat="{Binding Hat}"/>
                        </Grid>
                        <TextBlock x:Name="ClockText" Text="12:00" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBlock x:Name="DateText" Text="Mon, 1 Jan" FontSize="11" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="WeatherText" FontSize="11" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>

                    <Grid x:Name="RightCol" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- tabs -->
                        <Grid Height="30">
                            <Grid x:Name="TabStrip" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border x:Name="TabIndicator" Width="26" Height="28" CornerRadius="9" Background="#26FFFFFF"
                                        HorizontalAlignment="Left">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="TabIndicatorT"/>
                                    </Border.RenderTransform>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TabHome" Style="{StaticResource TabButton}" Content="&#xE80F;" IsChecked="True" Checked="Tab_Checked" ToolTip="Home"/>
                                    <RadioButton x:Name="TabMusic" Style="{StaticResource TabButton}" Content="&#xE8D6;" Checked="Tab_Checked" ToolTip="Music"/>
                                    <RadioButton x:Name="TabFocus" Style="{StaticResource TabButton}" Content="&#xE916;" Checked="Tab_Checked" ToolTip="Timers"/>
                                    <RadioButton x:Name="TabTodo" Style="{StaticResource TabButton}" Content="&#xE73A;" Checked="Tab_Checked" ToolTip="To-do"/>
                                    <RadioButton x:Name="TabNotes" Style="{StaticResource TabButton}" Content="&#xE70B;" Checked="Tab_Checked" ToolTip="Notes"/>
                                    <RadioButton x:Name="TabWater" Style="{StaticResource TabButton}" Checked="Tab_Checked" ToolTip="Water">
                                        <Path Data="M 5,0 C 5,0 10,6 10,9.5 A 5,5 0 1 1 0,9.5 C 0,6 5,0 5,0 Z" Width="10" Height="14.5" Stretch="Fill"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    </RadioButton>
                                    <RadioButton x:Name="TabShelf" Style="{StaticResource TabButton}" Content="&#xF12B;" Checked="Tab_Checked" ToolTip="Shelf"/>
                                    <RadioButton x:Name="TabShortcuts" Style="{StaticResource TabButton}" Content="&#xE718;" Checked="Tab_Checked" ToolTip="Shortcuts"/>
                                    <RadioButton x:Name="TabClip" Style="{StaticResource TabButton}" Content="&#xE77F;" Checked="Tab_Checked" ToolTip="Clipboard"/>
                                    <RadioButton x:Name="TabSound" Style="{StaticResource TabButton}" Content="&#xE767;" Checked="Tab_Checked" ToolTip="Sound"/>
                                    <RadioButton x:Name="TabSystem" Style="{StaticResource TabButton}" Content="&#xE7F4;" Checked="Tab_Checked" ToolTip="System"/>
                                    <RadioButton x:Name="TabCal" Style="{StaticResource TabButton}" Content="&#xE787;" Checked="Tab_Checked" ToolTip="Calendar"/>
                                </StackPanel>
                            </Grid>
                            <Button Style="{StaticResource IconButton}" Content="&#xE713;" HorizontalAlignment="Right" Click="Settings_Click" ToolTip="Settings"/>
                        </Grid>

                        <!-- nothing switched on -->
                        <StackPanel x:Name="NoFeatures" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock Text="Just Piztki" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Turn features back on in settings whenever you want them." FontSize="12"
                                       Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- home: every feature at a glance, one card each; click a card to open it -->
                        <Grid x:Name="PanelHome" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- one box that finds apps and files, does sums, and converts units and money -->
                            <Grid x:Name="SearchRow" Height="26" Margin="0,0,6,6">
                                <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Height="26" FontSize="12" MaxLength="80"
                                         TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" GotKeyboardFocus="SearchBox_GotFocus"/>
                                <StackPanel x:Name="SearchHint" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Search, calculate, or convert" FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <!-- scrolls with the mouse wheel when there are more cards than fit -->
                            <ScrollViewer x:Name="HomeScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-6,0">
                                <WrapPanel x:Name="HomeItems" VerticalAlignment="Top"/>
                            </ScrollViewer>
                            <ScrollViewer x:Name="SearchScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="-8,0,0,0" Visibility="Collapsed">
                                <StackPanel x:Name="SearchItems"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- music -->
                        <Grid x:Name="PanelMusic" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid x:Name="MusicOn" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- the lyric gets the panel's full width; long lines wrap onto a second row -->
                                <TextBlock x:Name="LyricText" Grid.Row="2" Grid.ColumnSpan="2" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" TextAlignment="Center" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" MaxHeight="33" LineHeight="16" Margin="0,5,0,0"/>
                                <Border x:Name="ArtHost" Width="84" Height="84" CornerRadius="14" Background="#1AFFFFFF" VerticalAlignment="Top">
                                    <Grid>
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="24" Foreground="{StaticResource SubtleBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border x:Name="ArtBorder" CornerRadius="14">
                                            <Border.Background>
                                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <StackPanel x:Name="SongInfo">
                                        <TextBlock x:Name="SongTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="SongArtist" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="-6,8,0,0">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click" ToolTip="Previous"/>
                                        <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Content="&#xE768;" Width="34" Height="34" FontSize="15" Margin="4,0" Click="Play_Click" ToolTip="Play or pause"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" ToolTip="Next"/>
                                        <Button x:Name="LyricsOpenBtn" Style="{StaticResource IconButton}" Content="&#xE720;" Margin="10,0,0,0" Click="LyricsOpen_Click" ToolTip="Sing along: show all the lyrics"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- progress: click or drag to jump -->
                                <Grid x:Name="SeekRow" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PosText" Text="0:00" FontSize="10.5" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center"/>
                                    <Grid x:Name="SeekTrack" Grid.Column="1" Height="16" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="Seek_MouseDown" MouseMove="Seek_MouseMove" MouseLeftButtonUp="Seek_MouseUp">
                                        <Border Height="4" CornerRadius="2" Background="#28FFFFFF" VerticalAlignment="Center">
                                            <Border CornerRadius="2" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="SeekBarS" ScaleX="0"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" FontSize="10.5" Foreground="{StaticResource SubtleBrush}"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                            <StackPanel x:Name="MusicOff" VerticalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="Nothing playing" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Play a song in any app and it shows up here." FontSize="12" Foreground="{StaticResource SubtleBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- sing-along page: every line of the song, scrolling, the current one lighting up as it is sung -->
                            <Grid x:Name="LyricsView" Visibility="Collapsed" Margin="0,-6,0,-8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- soft clouds in the cover's colors, drifting slowly behind the words -->
                                <!-- not clipped here: the clouds fade out on their own, and a clip would cut a hard rectangle into them -->
                                <Canvas x:Name="Clouds" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0">
                                    <Ellipse x:Name="Cloud1" Width="300" Height="210" Canvas.Left="-70" Canvas.Top="-50">
                                        <Ellipse.RenderTransform><TranslateTransform x:Name="Cloud1T"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="Cloud2" Width="280" Height="200" Canvas.Left="150" Canvas.Top="10">
                                        <Ellipse.RenderTransform><TranslateTransform x:Name="Cloud2T"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="Cloud3" Width="220" Height="170" Canvas.Left="60" Canvas.Top="60">
                                        <Ellipse.RenderTransform><TranslateTransform x:Name="Cloud3T"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                </Canvas>

                                <TextBlock x:Name="LyricsTitle" FontSize="11.5" Foreground="{StaticResource SubtleBrush}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,90,0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="LyricsPlayBtn" Style="{StaticResource IconButton}" Content="&#xE768;" Width="26" Height="26" FontSize="11" Click="Play_Click" ToolTip="Play or pause"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE740;" Width="26" Height="26" FontSize="11" Click="LyricsCinema_Click" ToolTip="Cinema: lyrics on the whole screen"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72B;" Width="26" Height="26" FontSize="11" Click="LyricsClose_Click" ToolTip="Back to the player"/>
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <c:LyricsColumn x:Name="LyricsCol" LineFontSize="15" LineGap="5" FocusAt="0.4"/>
                                    <TextBlock x:Name="LyricsEmpty" Text="Lyrics not available" FontSize="13" Foreground="{StaticResource SubtleBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- timers: focus, countdown, stopwatch -->
                        <Grid x:Name="PanelFocus" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Margin="-2,0,0,0">
                                    <RadioButton x:Name="ModeFocus" Style="{StaticResource MiniSegment}" Content="Focus" IsChecked="True" Checked="Mode_Checked"/>
                                    <RadioButton x:Name="ModeTimer" Style="{StaticResource MiniSegment}" Content="Timer" Checked="Mode_Checked"/>
                                    <RadioButton x:Name="ModeStopwatch" Style="{StaticResource MiniSegment}" Content="Stopwatch" Checked="Mode_Checked"/>
                                    <RadioButton x:Name="ModeStats" Style="{StaticResource MiniSegment}" Content="This week" Checked="Mode_Checked"/>
                                </StackPanel>
                                <StackPanel x:Name="TimerBody">
                                    <TextBlock x:Name="PomoLabel" Text="Ready to focus" FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PomoTime" Text="25:00" FontSize="36" FontWeight="SemiBold" Margin="-2,-5,0,0" HorizontalAlignment="Left"/>
                                    <Border Height="4" CornerRadius="2" Background="#22FFFFFF" Width="210" HorizontalAlignment="Left" Margin="0,1,0,0">
                                        <Border CornerRadius="2" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="PomoBarS" ScaleX="0"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="PomoStart" Style="{StaticResource PillButton}" Content="Start" Click="PomoStart_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Reset" Margin="8,0,0,0" Click="PomoReset_Click"/>
                                        <StackPanel x:Name="QuickAdd" Orientation="Horizontal" Visibility="Collapsed">
                                            <Button Style="{StaticResource GhostButton}" Content="+1 min" Padding="11,0" Margin="8,0,0,0" Tag="1" Click="QuickAdd_Click"/>
                                            <Button Style="{StaticResource GhostButton}" Content="+5 min" Padding="11,0" Margin="6,0,0,0" Tag="5" Click="QuickAdd_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <!-- how long you focused on each of the last seven days -->
                                <StackPanel x:Name="StatsBody" Visibility="Collapsed" Margin="0,7,0,0">
                                    <Grid>
                                        <TextBlock x:Name="StatsTitle" Text="No focus time yet" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="StatsSub" FontSize="11" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <UniformGrid x:Name="StatsBars" Rows="1" Columns="7" Height="92" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- notes -->
                        <Grid x:Name="PanelNotes" Grid.Row="1" Margin="0,6,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="NoteTitle" Text="Note 1 of 1" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Width="22" Height="22" FontSize="9" Click="NotePrev_Click" ToolTip="Previous note"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Width="22" Height="22" FontSize="9" Click="NoteNext_Click" ToolTip="Next note"/>
                                <Button Style="{StaticResource GhostButton}" Content="New note" Height="20" Padding="8,0" FontSize="10.5" FontWeight="Normal" Margin="4,0,2,0"
                                        Click="NoteNew_Click" ToolTip="Start another note"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Width="22" Height="22" FontSize="10" Click="NoteDelete_Click" ToolTip="Delete this note"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <TextBox x:Name="NoteBox" Style="{StaticResource NoteBox}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000"
                                         VerticalScrollBarVisibility="Hidden" TextChanged="NoteBox_TextChanged" PreviewKeyDown="NoteBox_PreviewKeyDown"/>
                                <TextBlock x:Name="NoteHint" Text="Write anything. It saves by itself." FontSize="12.5" Foreground="{StaticResource SubtleBrush}"
                                           Margin="12,7,0,0" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>

                        <!-- shortcuts: the apps, files, and folders you open most -->
                        <Grid x:Name="PanelShortcuts" Grid.Row="1" Margin="0,6,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Shortcuts" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Content="Add app or file" Height="20" Padding="8,0" FontSize="10.5" FontWeight="Normal"
                                        Click="ShortcutAddFile_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="Add folder" Height="20" Padding="8,0" FontSize="10.5" FontWeight="Normal" Margin="4,0,0,0"
                                        Click="ShortcutAddFolder_Click"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" Margin="-6,4,-6,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="ShortcutItems"/>
                            </ScrollViewer>
                            <TextBlock x:Name="ShortcutEmpty" Grid.Row="1" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,0,14"
                                       Text="Pin the apps, files, and folders you open most. Use the buttons above, or drag something onto the notch while this tab is open."/>
                        </Grid>

                        <!-- sound: a volume slider for every app, and the microphone -->
                        <Grid x:Name="PanelSound" Grid.Row="1" Margin="0,6,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Discord voice: the channel, who is talking, and Discord's own mute / deafen -->
                            <Grid x:Name="DiscordRow" Grid.Row="1" Height="26" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,150,0">
                                    <Ellipse x:Name="DiscordDot" Width="7" Height="7" Fill="#55FFFFFF" Margin="1,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DiscordText" Text="Discord" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="DiscordMuteBtn" Style="{StaticResource GhostButton}" Content="Mute" Height="22" Padding="10,0" FontSize="11" FontWeight="Normal"
                                            Click="DiscordMute_Click" ToolTip="Mutes you in Discord only"/>
                                    <Button x:Name="DiscordDeafBtn" Style="{StaticResource GhostButton}" Content="Deafen" Height="22" Padding="10,0" FontSize="11" FontWeight="Normal"
                                            Margin="6,0,0,0" Click="DiscordDeaf_Click" ToolTip="Stops you hearing the call, and mutes you"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,96,0">
                                <Ellipse x:Name="MicStateDot" Width="7" Height="7" Fill="#55FFFFFF" Margin="1,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MicStateText" Text="Microphone" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="MicMuteBtn" Style="{StaticResource GhostButton}" Content="Mute mic" Height="22" Padding="10,0" FontSize="11" FontWeight="Normal"
                                    HorizontalAlignment="Right" Click="MicMute_Click" ToolTip="Mutes the microphone for every app"/>
                            <ScrollViewer Grid.Row="2" Margin="0,4,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="SoundItems"/>
                            </ScrollViewer>
                            <TextBlock x:Name="SoundEmpty" Grid.Row="2" Text="No app is playing sound right now. Start something and it shows up here with its own volume."
                                       FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed"/>
                        </Grid>

                        <!-- to-do -->
                        <Grid x:Name="PanelTodo" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBox x:Name="TodoInput" Style="{StaticResource DarkTextBox}" KeyDown="TodoInput_KeyDown" MaxLength="80"/>
                                <TextBlock x:Name="TodoHint" Text="Add a task and press Enter" FontSize="12.5" Foreground="{StaticResource SubtleBrush}"
                                           Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="TodoList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Background="Transparent" Loaded="TodoItem_Loaded" ClipToBounds="True">
                                                <Grid Margin="2,3,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource RoundCheck}" IsChecked="{Binding Done, Mode=TwoWay}" Click="TodoCheck_Click" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="ItemText" Grid.Column="1" Text="{Binding Text}" FontSize="12.5" Margin="9,0,6,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Width="22" Height="22" FontSize="9"
                                                            Foreground="{StaticResource SubtleBrush}" Click="TodoDelete_Click" ToolTip="Remove"/>
                                                </Grid>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Done}" Value="True">
                                                    <Setter TargetName="ItemText" Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter TargetName="ItemText" Property="Foreground" Value="{StaticResource SubtleBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- water -->
                        <Grid x:Name="PanelWater" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="WaterLabel" Text="0 of 8 glasses today" FontSize="14" FontWeight="SemiBold"/>
                                <WrapPanel x:Name="WaterDrops" Margin="0,10,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource PillButton}" Content="I drank a glass" Click="WaterAdd_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Undo" Margin="8,0,0,0" Click="WaterUndo_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- shelf -->
                        <Grid x:Name="PanelShelf" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="Take a screenshot" Height="22" Padding="10,0" FontSize="11" FontWeight="Normal"
                                        Click="Screenshot_Click"
                                        ToolTip="Drag over part of the screen. The picture lands on the shelf and is copied too"/>
                                <Button Style="{StaticResource GhostButton}" Content="Pick a color" Height="22" Padding="10,0" FontSize="11" FontWeight="Normal"
                                        Margin="6,0,0,0" Click="PickColor_Click"
                                        ToolTip="Click any pixel on the screen to copy its color code"/>
                                <!-- the last few picked colors: click one to copy it again -->
                                <StackPanel x:Name="ColorSwatches" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="ShelfEmpty" VerticalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="Your shelf is empty" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Drag files onto the notch to park them here, then drag them out wherever you need them."
                                           FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ScrollViewer x:Name="ShelfScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                                <WrapPanel x:Name="ShelfItems"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- clipboard -->
                        <Grid x:Name="PanelClip" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                            <StackPanel x:Name="ClipEmpty" VerticalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="Nothing copied yet" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Text you copy shows up here. Click an entry to copy it again. Nothing is saved after you quit."
                                           FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Grid x:Name="ClipFilled" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="-8,0,0,0">
                                    <StackPanel x:Name="ClipItems"/>
                                </ScrollViewer>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74D;" VerticalAlignment="Top" Click="ClipClear_Click" ToolTip="Clear the list"/>
                            </Grid>
                        </Grid>

                        <!-- system -->
                        <Grid x:Name="PanelSystem" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="84"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Bluetooth headphones, mice, and controllers that report a battery level -->
                                <Grid x:Name="DeviceBatRow" Grid.Row="4" Grid.ColumnSpan="3" Height="28" Visibility="Collapsed">
                                    <TextBlock Text="Devices" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="DeviceBatText" Style="{StaticResource StatValue}" TextTrimming="CharacterEllipsis" MaxWidth="290"/>
                                </Grid>

                                <TextBlock Text="CPU" Style="{StaticResource StatLabel}"/>
                                <Border Grid.Column="1" Style="{StaticResource StatTrack}">
                                    <Border CornerRadius="2.5" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="CpuBarS" ScaleX="0"/></Border.RenderTransform>
                                    </Border>
                                </Border>
                                <TextBlock x:Name="CpuText" Grid.Column="2" Text="0%" Style="{StaticResource StatValue}"/>

                                <TextBlock Grid.Row="1" Text="Memory" Style="{StaticResource StatLabel}"/>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatTrack}">
                                    <Border CornerRadius="2.5" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="MemBarS" ScaleX="0"/></Border.RenderTransform>
                                    </Border>
                                </Border>
                                <TextBlock x:Name="MemText" Grid.Row="1" Grid.Column="2" Text="0 GB" Style="{StaticResource StatValue}"/>

                                <TextBlock Grid.Row="2" Text="Network" Style="{StaticResource StatLabel}"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE74B;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NetDownText" Text="0 KB/s" FontSize="12" FontWeight="SemiBold" Margin="5,0,16,0" MinWidth="64"/>
                                    <TextBlock Text="&#xE74A;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NetUpText" Text="0 KB/s" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0"/>
                                </StackPanel>

                                <Grid x:Name="BatteryRow" Grid.Row="3" Grid.ColumnSpan="3" Height="28" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="84"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Battery" Style="{StaticResource StatLabel}"/>
                                    <Border Grid.Column="1" Style="{StaticResource StatTrack}">
                                        <Border CornerRadius="2.5" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform><ScaleTransform x:Name="BatBarS" ScaleX="0"/></Border.RenderTransform>
                                        </Border>
                                    </Border>
                                    <TextBlock x:Name="BatText" Grid.Column="2" Text="0%" Style="{StaticResource StatValue}"/>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- calendar: the month on the left; world clocks, the moon, and a countdown on the right -->
                        <Grid x:Name="PanelCal" Grid.Row="1" Margin="0,6,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="162"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Grid Height="22">
                                    <TextBlock x:Name="CalTitle" Text="November 2026" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Width="22" Height="22" FontSize="9" Click="CalPrev_Click" ToolTip="Previous month"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Width="22" Height="22" FontSize="9" Click="CalNext_Click" ToolTip="Next month"/>
                                    </StackPanel>
                                </Grid>
                                <UniformGrid x:Name="CalGrid" Columns="7" Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- right side, view 1: the selected day's events, with a box to add one -->
                            <Grid x:Name="CalEvents" Grid.Column="1" Margin="14,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DayTitle" Text="Today" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <!-- a labelled button: an icon alone didn't make it clear this switches views -->
                                <Button Style="{StaticResource GhostButton}" Content="World clocks" Height="20" Padding="8,0" FontSize="10.5" FontWeight="Normal"
                                        HorizontalAlignment="Right" Click="CalView_Click" ToolTip="World clocks, the moon, and your countdown"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,4">
                                    <StackPanel x:Name="EventItems"/>
                                </ScrollViewer>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="EventTitleBox" Style="{StaticResource DarkTextBox}" Height="28" FontSize="12" MaxLength="40" KeyDown="EventBox_KeyDown"/>
                                    <TextBlock x:Name="EventTitleHint" Text="New event" FontSize="12" Foreground="{StaticResource SubtleBrush}"
                                               Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBox x:Name="EventTimeBox" Grid.Column="1" Style="{StaticResource DarkTextBox}" Height="28" FontSize="12" MaxLength="5"
                                             Margin="4,0,0,0" KeyDown="EventBox_KeyDown" ToolTip="Time, like 14:30"/>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE710;" Width="26" Height="26" FontSize="11" Margin="2,0,-4,0"
                                            Click="EventAdd_Click" ToolTip="Add the event"/>
                                </Grid>
                            </Grid>

                            <!-- right side, view 2: world clocks, the moon, and the countdown -->
                            <StackPanel x:Name="CalWorld" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Grid Height="24">
                                    <TextBlock Text="World" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource PillButton}" Content="My events" Height="20" Padding="8,0" FontSize="10.5"
                                            HorizontalAlignment="Right" Click="CalView_Click" ToolTip="Back to the events of the selected day"/>
                                </Grid>
                                <Grid Height="26">
                                    <TextBlock x:Name="City1Name" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="City1Time" Style="{StaticResource StatValue}"/>
                                </Grid>
                                <Grid Height="26">
                                    <TextBlock x:Name="City2Name" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="City2Time" Style="{StaticResource StatValue}"/>
                                </Grid>
                                <Grid Height="26">
                                    <TextBlock Text="Moon" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="MoonText" Style="{StaticResource StatValue}"/>
                                </Grid>
                                <Grid x:Name="CountdownRow" Height="26">
                                    <TextBlock x:Name="CountdownLabel" Style="{StaticResource StatLabel}" TextTrimming="CharacterEllipsis" MaxWidth="84" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="CountdownText" Style="{StaticResource StatValue}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- quick timer: press the notch, pull down, and let go on a time -->
                <Grid x:Name="QuickTimer" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border x:Name="QuickBack" CornerRadius="23" Background="#FF0A0A0D"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Quick timer" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="QuickHint" Text="Let go on a time to start it" FontSize="11.5" Foreground="{StaticResource SubtleBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,14"/>
                        <StackPanel x:Name="QuickChips" Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- accent ring that pulses when Piztki has something to say -->
                <Border x:Name="Glow" CornerRadius="23" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                        Opacity="0" IsHitTestVisible="False"/>
            </Grid>
        </Border>

            <Path x:Name="ShoulderRight" Data="M 12,0 L 0,0 L 0,12 A 12,12 0 0 1 12,0 Z" Fill="#FF0A0A0D"
                  VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"/>
        </StackPanel>
    </Grid>
</Window>
